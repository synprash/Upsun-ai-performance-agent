# Google Gemini AI Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-pro

# Blackfire Credentials
BLACKFIRE_CLIENT_ID=your_blackfire_client_id
BLACKFIRE_CLIENT_TOKEN=your_blackfire_client_token
BLACKFIRE_ENVIRONMENT_UUID=your_environment_uuid
BLACKFIRE_SERVER_ID=your_server_id
BLACKFIRE_SERVER_TOKEN=your_server_token

# Upsun / Platform.sh Credentials
UPSUN_PROJECT_ID=your_upsun_project_id
UPSUN_CLI_TOKEN=your_upsun_api_token

# Notification Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK
